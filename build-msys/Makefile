	$(MAKE) -f CMakeFiles/Makefile2 test06-debug
.PHONY : test06-debug

# fast build rule for target.
test06-debug/fast:
	$(MAKE) -f tests/06-debug/CMakeFiles/test06-debug.dir/build.make tests/06-debug/CMakeFiles/test06-debug.dir/build
.PHONY : test06-debug/fast

