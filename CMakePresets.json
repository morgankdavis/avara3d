{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/cmake-build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "vendor": {
                "jetbrains.com/clion": {
                    "toolchain": "Default"
                }
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/cmake-build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "vendor": {
                "jetbrains.com/clion": {
                    "toolchain": "Default"
                }
            }
        },
        {
            "name": "web-debug",
            "displayName": "Web Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/cmake-build-web-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "A3D_BUILD_DOCUMENTATION": "OFF",
                "CMAKE_MESSAGE_LOG_LEVEL": "ERROR",
                "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
            },
            "warnings": {
                "unusedCli": false
            },
            "vendor": {
                "jetbrains.com/clion": {
                    "toolchain": "Default"
                }
            }
        },
        {
            "name": "web-release",
            "displayName": "Web Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/cmake-build-web-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "A3D_BUILD_DOCUMENTATION": "OFF",
                "CMAKE_MESSAGE_LOG_LEVEL": "ERROR",
                "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
            },
            "warnings": {
                "unusedCli": false
            },
            "vendor": {
                "jetbrains.com/clion": {
                    "toolchain": "Default"
                }
            }
        },
        {
            "name": "python-debug",
            "displayName": "Python Debug",
            "inherits": "debug",
            "binaryDir": "${sourceDir}/cmake-build-python-debug",
            "cacheVariables": {
                "A3D_BUILD_PYTHON": "ON",
                "Python_ROOT_DIR": "${sourceDir}/.venv"
            }
        },
        {
            "name": "python-release",
            "displayName": "Python Release",
            "inherits": "release",
            "binaryDir": "${sourceDir}/cmake-build-python-release",
            "cacheVariables": {
                "A3D_BUILD_PYTHON": "ON",
                "Python_ROOT_DIR": "${sourceDir}/.venv"
            }
        },
        {
            "name": "python-web",
            "displayName": "Python Web",
            "inherits": "release",
            "binaryDir": "${sourceDir}/cmake-build-python-web",
            "cacheVariables": {
                "A3D_BUILD_PYTHON": "OFF",
                "A3D_BUILD_PYTHON_WEB": "ON",
                "A3D_BUILD_AUTOMATED_TESTS": "OFF",
                "A3D_BUILD_SANDBOX_TESTS": "OFF",
                "A3D_BUILD_DEMOS": "OFF",
                "A3D_BUILD_EDITOR": "OFF",
                "A3D_BUILD_DOCUMENTATION": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "web-debug",
            "configurePreset": "web-debug"
        },
        {
            "name": "web-release",
            "configurePreset": "web-release"
        },
        {
            "name": "python-debug",
            "configurePreset": "python-debug",
            "targets": [
                "_avara3d"
            ]
        },
        {
            "name": "python-release",
            "configurePreset": "python-release",
            "targets": [
                "_avara3d"
            ]
        },
        {
            "name": "python-web",
            "configurePreset": "python-web",
            "targets": [
                "a3d-python-web"
            ]
        }
    ]
}
